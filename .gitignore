# ── Исследовательские материалы ───────────────────────────────
# Датасеты, выгрузки метрик, сохранённые ответы агента, разметка
# релевантности. Рабочие материалы разработки: десятки мегабайт,
# пересобираются скриптами, продукту не нужны.
#
# Шаблон со звёздочкой, а не `_research/`: закрытую папку git не открывает
# по исключению, и `!_research/EVOLUTION.md` под ней не сработал бы.
_research/*

# Исключение: журнал замеров. Это не материал, а результат — в нём
# записано, почему каждая константа проекта равна тому, чему равна,
# и что именно было отвергнуто по дороге. README и CLAUDE.md ссылаются
# на него, поэтому без него оба ведут в пустоту.
!_research/EVOLUTION.md
!_research/README.md

# ── Данные и индекс ───────────────────────────────────────────
# Скачиваются и собираются локально: data_sources.py, foods.py, build_index.py
data/
lance_db/*
!lance_db/.gitkeep

# Исключение: каталог блюд и справочник статей едут в репозиторий.
#
# Причина — тесты. Больше половины из них стерегут ДАННЫЕ, а не код:
# «не вернулась ли шкура в названия», «даёт ли основное блюдо белок»,
# «не попало ли в подбор сырое мясо». Без каталога conftest их пропускает,
# и на чистой машине из 318 тестов проходили 143, а остальные молча
# скипались — зелёная галочка, за которой ничего нет.
#
# Пересобрать каталог в CI нельзя: в нём есть колонки, которые делает
# модель (перевод, доступность, привычность), а ключей в CI нет.
#
# Вместе это 756 КБ. Векторный индекс на 44 МБ по-прежнему не едет —
# тестам он не нужен, провайдер и ретривер подменены заглушками.
!data/
!data/processed/
!data/processed/foods.parquet
!data/processed/corpus_index.json

# Сырьё остаётся снаружи: 28 МБ выгрузки USDA и абстрактов PubMed,
# из которых каталог и индекс уже собраны. Открывать папку data/
# пришлось ради двух файлов выше, поэтому сырьё закрываем отдельно.
data/raw/

# Резервные копии каталога, которые остаются после ручных правок.
*.bak

# ── Секреты ───────────────────────────────────────────────────
.env

# ── Питон ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# ── Прочее ────────────────────────────────────────────────────
.DS_Store
*.log

# ── Выгрузки ──────────────────────────────────────────────────
# Меню, собранные локально через `python export.py`.
menu.xlsx
*.xlsx

# Точки отсчёта для замеров солвера — локальные, у каждого свои.
_research/baselines/
