# В образ едут только артефакты, нужные в рантайме (~45 МБ).
# Сырьё и кэши остаются снаружи: они нужны лишь для пересборки индекса.

# Выгрузка USDA и абстракты PubMed (28 МБ): из них уже собраны
# foods.parquet и индекс, для работы сервиса не требуются.
data/raw/

# Кэш эмбеддингов (169 МБ): нужен только чтобы не платить за повторную
# векторизацию. Внутри контейнера пересборки не бывает.
lance_db/embedding_cache/

# Рабочие материалы разработки: датасеты и отчёты о проверке точности.
_research/

# Секреты передаются через env_file на запуске.
.env

# Инструменты разработки в рантайме не нужны.
tests/
run_eval.py
experiments/
build_qrels.py
diagnose_corpus.py
make_eval_dataset.py
evaluation.py
evaluation_answers.py

# Разовая подготовка данных: загрузка сырья, сборка индекса, перевод
# каталога и две ревизии. Все работают по сырью или по готовому каталогу,
# а в образ и то и другое приезжает собранным.
#
# data_sources.py исключён только после того, как его перестали импортировать
# наверху модулей: `foods` и `data_preporation` тянули его транзитом ради
# веток пересборки, и загрузчик с urllib уезжал в работающий сервис,
# где не выполняется никогда. Теперь импорт внутри функций, и рантайм
# обходится одиннадцатью модулями вместо двенадцати.
data_sources.py
build_index.py
review_catalog.py
review_familiar.py
translate_catalog.py
measurement.py

# Материалы для работы над самим репозиторием, не для запуска.
CLAUDE.md
.claude/

# Мусор
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
.git/
*.log
