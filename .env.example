# Скопируйте этот файл в .env и подставьте свои ключи.
#
# Обязателен только POLZA_AI_API_KEY: через него идут эмбеддинги
# (ими построен поисковый индекс) и, по умолчанию, генерация ответов.
POLZA_AI_API_KEY=

# Необязательно: альтернативный провайдер генерации.
# Чтобы включить, запустите с LLM_PROVIDER=gigachat
GIGACHAT_API_KEY=
GIGACHAT_SSL_VERIFY=false

# polza (по умолчанию) | gigachat
LLM_PROVIDER=polza

# DEBUG | INFO | WARNING
LOG_LEVEL=INFO

# Журнал чата: одна JSON-строка на реплику, файл на сутки (chat_log.py).
# По умолчанию — папка logs/ рядом с кодом; off выключает журнал.
# CHAT_LOG_DIR=logs
# CHAT_LOG_RETENTION_DAYS=30

# Хранилище разговоров и меню (storage.py): путь к SQLite или memory.
# В контейнере — том /app/state (см. docker-compose.yml).
# STATE_DB=state/agent.sqlite3
# SESSION_TTL_DAYS=30
# MENU_TTL_DAYS=7
# Cookie сессии только по HTTPS — включать за прокси с TLS.
# SESSION_COOKIE_SECURE=false

# Ограничения (limits.py). Реплика в чате — 4-7 платных вызовов модели.
# CHAT_PER_MINUTE_SESSION=6
# CHAT_PER_HOUR_SESSION=60
# CHAT_PER_MINUTE_IP=20
# CHAT_PER_HOUR_IP=200
# STREAMS_PER_IP=3
# CALC_PER_MINUTE_IP=60
# MENU_PER_MINUTE_IP=6
# Потолок вызовов модели на весь сервис в сутки (UTC).
# LLM_CALLS_PER_DAY=3000
