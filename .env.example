# Скопируйте этот файл в .env и подставьте свои ключи.
#
# Обязателен только POLZA_AI_API_KEY: через него идут эмбеддинги
# (ими построен поисковый индекс) и, по умолчанию, генерация ответов.
POLZA_AI_API_KEY=

# Необязательно: альтернативный провайдер генерации.
# Чтобы включить, запустите с LLM_PROVIDER=gigachat
GIGACHAT_API_KEY=
GIGACHAT_SSL_VERIFY=false

# polza (по умолчанию) | gigachat
LLM_PROVIDER=polza

# DEBUG | INFO | WARNING
LOG_LEVEL=INFO
