# Переводы строк нормализуются в LF в репозитории.
#
# Без этого файла проект, собранный на Windows, на любой другой машине
# покажет изменёнными все текстовые файлы разом — из-за CRLF, а не из-за
# содержания. Настоящая правка утонет в таком диффе.
* text=auto eol=lf

# Бинарные артефакты трогать нельзя: нормализация их испортит.
*.parquet binary
*.xlsx binary
*.png binary
*.jpg binary
*.ico binary

# Замок зависимостей и выгрузки данных в статистике языков не участвуют —
# иначе GitHub решит, что проект написан на JSON.
uv.lock linguist-generated=true
data/processed/corpus_index.json linguist-generated=true
